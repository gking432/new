# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI
# Enables AI lead analysis, summaries, follow-up generation, and live Realtime voice.
# Without this key, the app uses deterministic fallbacks and scripted call mode.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
ENABLE_REALTIME_CALLS=true
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=cedar
REALTIME_MAX_CALL_SECONDS=180

# CRM sync
# Dry-run mode works without a token and logs the exact payloads.
HUBSPOT_PRIVATE_APP_TOKEN=
ENABLE_HUBSPOT_LIVE_SYNC=false

# One-time scheduled-report email demo
# Verify the sender domain in Resend before enabling public delivery.
RESEND_API_KEY=
REPORT_EMAIL_FROM="Northstar AI Demo <reports@your-domain.com>"
REPORT_EMAIL_REPLY_TO=

# Webhook exports
MAKE_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
WEBHOOK_SECRET=

# Demo guardrails
# Keep true/empty for portfolio demos. Set DEMO_MODE=false only when live
# integrations should actually call external services.
DEMO_MODE=true
# When true/empty, each new browser tab/session clears demo-created operational
# data on first load so portfolio visitors start from a blank slate.
DEMO_AUTO_RESET_ON_LOAD=true
DEMO_COMPANY_NAME="Northstar Exterior & Home"
